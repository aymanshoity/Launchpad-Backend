// -----------------product Section---------------
model Topic {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique @db.Citext
  name String @unique

  products  ProductTopic[]
  followers TopicFollow[]

  @@map("topics")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  founderId   String        @map("founder_id") @db.Uuid
  name        String
  slug        String        @unique @db.Citext
  pitch       String        @db.VarChar()
  description String
  websiteUrl  String        @map("website_url")
  status      ProductStatus @default(draft)

  launchDate  DateTime? @map("launch_date") @db.Date
  launchedAt  DateTime? @map("launched_at") @db.Timestamptz(6)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)

  isFeatured Boolean @default(false) @map("is_featured")
  voteCount  Int     @default(0) @map("vote_count")
  score      Float   @default(0)

  searchTsv Unsupported("tsvector")? @map("search_tsv")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  founder User           @relation("ProductFounder", fields: [founderId], references: [id])
  topics  ProductTopic[]
  media   ProductMedia[]

  reviews ProductReview[]
  votes         Vote[]
  comments      Comment[]
  reports       Report[]
  dailyRankings DailyRanking[]
  rankSnapshots RankSnapshot[]
  featuredSlots FeaturedSlot[]
  notifications Notification[]
  viewEvents    ProductViewEvent[]
  dailyStats    ProductDailyStat[]
  exportJobs    ExportJob[]
  voteFlags     VoteFlag[]

  @@index([founderId])
  @@index([status, launchDate, score(sort: Desc)])
  @@index([status, submittedAt])
  @@map("products")
}

model ProductMedia {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  kind      MediaKind
  fileUrl   String    @map("file_url")
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model ProductTopic {
  productId String @map("product_id") @db.Uuid
  topicId   String @map("topic_id") @db.Uuid

  topic   Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, topicId])
  @@index([topicId])
  @@map("product_topics")
}

model ProductReview {
  id         String         @id @default(uuid()) @db.Uuid
  productId  String         @map("product_id") @db.Uuid
  reviewerId String         @map("reviewer_id") @db.Uuid
  decision   ReviewDecision
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewr User    @relation("ReviewerReviews", fields: [reviewerId], references: [id])

  @@index([productId, createdAt])
  @@map("product_reviews")
}

model AppSetting {
  key      String   @id
  value    String
  updateAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

// engagement

model Vote {
  userId     String   @map("user_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  ip         String?  @db.Inet
  deviceHash String?  @map("device_hash")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId, createdAt])
  @@index([ip, createdAt])
  @@map("votes")
}

model Comment{
  id String @id @default(uuid()) @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  parentCommentId String?       @map("parent_comment_id") @db.Uuid
  body String
  status CommentStatus @default(visible)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt DateTime? @map("edited_at") @db.Timestamptz(6)

  product Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  reports       Report[]
  notifications Notification[] 

  @@index([productId,createdAt])
  @@index([parentCommentId])
  @@map("comments")
}

model Report{
  id              String       @id @default(uuid()) @db.Uuid
  reporterId String @map("reporter_id") @db.Uuid
  targetProductId String? @map("target_product_id") @db.Uuid
  targetCommentId String? @map("target_comment_id") @db.Uuid
  reason String
  status ReportStatus @default(open)
  handledById String? @map("handled_by") @db.Uuid
  handledAt DateTime? @map("handled_at") @db.Timestamptz(6)
  resolutionNote String? @map("resolution_note")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reporter User @relation("ReportReporter" ,fields: [reporterId] ,references: [id] )
  handledBy User? @relation("ReportHandler" ,fields: [handledById] ,references: [id] )
  targetProduct Product? @relation(fields: [targetProductId] ,references: [id] ,onDelete: Cascade)
  targetComment Comment? @relation(fields: [targetCommentId] ,references: [id] ,onDelete: Cascade)

  @@index([status,createdAt])
  @@map("reports")
}

model UserFollow {
  followerId String   @map("follower_id") @db.Uuid
  followedId String   @map("followed_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId])
  @@map("user_follows")
}

model TopicFollow {
  userId    String   @map("user_id") @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([topicId])
  @@map("topic_follows")
}

model DailyRanking {
  launchDate DateTime @map("launch_date") @db.Date
  productId  String   @map("product_id") @db.Uuid
  finalRank  Int      @map("final_rank")
  finalScore Float    @map("final_score")
  finalVotes Int      @map("final_votes")

  product Product @relation(fields: [productId], references: [id])

  @@id([launchDate, productId])
  @@unique([launchDate, finalRank])
  @@map("daily_rankings")
}

// Hourly while live; powers "where it ranked" on the dashboard
model RankSnapshot {
  productId  String   @map("product_id") @db.Uuid
  capturedAt DateTime @map("captured_at") @db.Timestamptz(6)
  rank       Int
  score      Float
  voteCount  Int      @map("vote_count")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, capturedAt])
  @@map("rank_snapshots")
}

model FeaturedSlot {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  slotOrder   Int      @default(0) @map("slot_order")
  startsAt    DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime @map("ends_at") @db.Timestamptz(6)
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([startsAt, endsAt])
  @@map("featured_slots")
}

// =====================================================================
// 5. NOTIFICATIONS
// =====================================================================

// In-app bell
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  productId String?          @map("product_id") @db.Uuid
  commentId String?          @map("comment_id") @db.Uuid
  payload   Json             @default("{}") @db.JsonB
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

// Missing row = default (on). Check BEFORE queuing any optional email.
model NotificationPreference {
  userId       String           @map("user_id") @db.Uuid
  type         NotificationType
  emailEnabled Boolean          @default(true) @map("email_enabled")
  inappEnabled Boolean          @default(true) @map("inapp_enabled")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

// Every email is a row first; a worker sends it and retries on failure
model EmailOutbox {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  toEmail       String      @map("to_email") @db.Citext
  type          EmailType
  subject       String
  bodyHtml      String      @map("body_html")
  status        EmailStatus @default(pending)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?     @map("last_error")
  dedupeKey     String?     @unique @map("dedupe_key") // stops double-sending
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt        DateTime?   @map("sent_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

// =====================================================================
// 6. FOUNDER DASHBOARD & EXPORTS
// =====================================================================

model ProductViewEvent {
  id          BigInt   @id @default(autoincrement())
  productId   String   @map("product_id") @db.Uuid
  viewerId    String?  @map("viewer_id") @db.Uuid
  referrer    String?
  visitorHash String?  @map("visitor_hash")
  viewedAt    DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewer  User?   @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([productId, viewedAt])
  @@map("product_view_events")
}

model ProductDailyStat {
  productId      String   @map("product_id") @db.Uuid
  statDate       DateTime @map("stat_date") @db.Date
  views          Int      @default(0)
  uniqueVisitors Int      @default(0) @map("unique_visitors")
  votes          Int      @default(0)
  comments       Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, statDate])
  @@map("product_daily_stats")
}

model ExportJob {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  requestedById String    @map("requested_by") @db.Uuid
  status        JobStatus @default(queued)
  fileUrl       String?   @map("file_url")
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  requestedBy User    @relation(fields: [requestedById], references: [id])

  @@index([requestedById, createdAt(sort: Desc)])
  @@index([status])
  @@map("export_jobs")
}

// =====================================================================
// 7. STAFF TOOLS & ANTI-CHEAT
// =====================================================================

model StaffAuditLog {
  id         String       @id @default(uuid()) @db.Uuid
  actorId    String       @map("actor_id") @db.Uuid
  action     StaffActions
  targetType String       @map("target_type") // 'user' | 'product' | 'comment' | 'report'
  targetId   String       @map("target_id") @db.Uuid
  reason     String?
  metadata   Json?        @db.JsonB // put before/after values here
  ipAddress  String?      @map("ip_address") @db.Inet
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // Restrict, not Cascade - deleting a user must never erase the audit trail
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@map("staff_audit_log")
}

// Suspicious voting found by a background job; staff review them
model VoteFlag {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String?   @map("product_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  reason       String // same_ip_cluster | burst | new_account ...
  details      Json      @default("{}") @db.JsonB
  reviewedById String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?    @relation("FlaggedUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("FlagReviewer", fields: [reviewedById], references: [id])

  @@index([reviewedAt, createdAt])
  @@map("vote_flags")
}


