// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, pg_trgm]
}

enum UserRole {
  member
  reviewer
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  deleted

  @@map("user_status")
}

enum AuthProvider {
  email
  google

  @@map("auth_provider")
}

enum TokenPurpose {
  verify_email
  reset_password

  @@map("token_purpose")
}

enum StaffActions {
  suspend_user
  unsuspend_user
  change_role
  approve_product
  reject_product
  request_product_changes
  takedown_product
  restore_product
  feature_product
  unfeature_product
  hide_comment
  restore_comment
  resolve_report
  dismiss_report

  @@map("staff_action")
}

enum ProductStatus {
  draft
  in_review
  changes_requested
  rejected
  approved
  scheduled
  live
  taken_down

  @@map("product_status")
}

enum ReviewDecision {
  approved
  rejected
  changes_requested

  @@map("review_decision")
}

enum MediaKind {
  logo
  screenshot

  @@map("media_kind")
}

enum CommentStatus {
  visible
  hidden
  deleted

  @@map("comment_status")
}

enum ReportStatus {
  open
  dismissed
  actioned

  @@map("report_status")
}

// Types the member can switch off (used by notifications + preferences)
enum NotificationType {
  product_approved
  product_rejected
  product_changes_requested
  launch_reminder
  product_live
  comment_on_product
  reply_to_comment
  daily_top5
  weekly_best

  @@map("notification_type")
}

// Every email kind. verify_email / reset_password can never be switched off.
enum EmailType {
  verify_email
  reset_password
  product_approved
  product_rejected
  product_changes_requested
  launch_reminder
  product_live
  comment_on_product
  daily_top5
  weekly_best

  @@map("email_type")
}

enum EmailStatus {
  pending
  sending
  sent
  failed
  skipped

  @@map("email_status")
}

enum JobStatus {
  queued
  running
  ready
  failed

  @@map("job_status")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email           String    @unique @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)

  passwordHash      String?   @map("password_hash")
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz()
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz()

  headline    String
  username    String? @db.VarChar(50)
  displayName String? @map("display_name")
  avatarURL   String? @map("avatar_url")

  role   UserRole   @default(member)
  status UserStatus @default(active)

  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspendedReason String?   @map("suspended_reason")

  // anti-cheat signals
  signupIp    String?   @map("signup_ip") @db.Inet
  lastLoginIp String?   @map("last_login_ip") @db.Inet
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz

  // 
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // auth
  sessions       Session[]
  authTokens     AuthToken[]
  oauthAccounts  OAuthAccount[]
  staffAuditLogs StaffAuditLog[]

  // products
  products       Product[]       @relation("ProductFounder")
  productReviews ProductReview[] @relation("ReviewerReviews")
  featuredSlots  FeaturedSlot[]
  votes          Vote[]
  comments       Comment[]
  reportsFiled      Report[]      @relation("ReportReporter")
  reportsHandled    Report[]      @relation("ReportHandler")
  following         UserFollow[]  @relation("Follower")
  followers         UserFollow[]  @relation("Followed")
  topicFollows      TopicFollow[]
  voteFlags         VoteFlag[]        @relation("FlaggedUser")
  voteFlagsReviewed VoteFlag[]        @relation("FlagReviewer")
  productViews      ProductViewEvent[]

  // notifications
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  emails                  EmailOutbox[]
  exportJobs              ExportJob[]


  @@index([status])
  @@index([role])
  @@index([signupIp, createdAt(sort: Desc)])
  @@map("users")
}

model OAuthAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  email          String       @db.Citext
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_account")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?   @map("ip") @db.Inet
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

